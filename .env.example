# SGC Tech AI — environment variables
# Copy to .env.local for local dev. On Vercel, set in Project Settings → Environment Variables.
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser. Everything
# else (no NEXT_PUBLIC_ prefix) stays server-only and is safe for secrets.

# ── Analytics (optional) ───────────────────────────────────────────────────
# Google Analytics 4 measurement ID. Format: G-XXXXXXXXXX.
# When set, gtag.js + a page_view event are injected via next/script in app/layout.tsx.
# When unset, the site ships clean with no analytics code.
NEXT_PUBLIC_GA_ID=

# ── Odoo CRM lead capture (required for /api/contact and /api/diagnostic-lead) ──
# Used server-side only (lib/odoo.ts) — never exposed to the browser.
# Without these set, both API routes fail closed with a 502 and the forms
# show a friendly error asking the user to email/WhatsApp instead.
#
# ODOO_URL: base URL of the Odoo instance, e.g. https://app.sgctech.ai
# ODOO_DB: database name, e.g. odoo19-sgc
# ODOO_USERNAME: login email of the API user
# ODOO_API_KEY: Odoo API key for that user (Settings → Users → API Keys) —
#   treat this like a password. Rotate it if it is ever exposed.
ODOO_URL=
ODOO_DB=
ODOO_USERNAME=
ODOO_API_KEY=